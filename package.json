{
  "name": "mirai-rpg",
  "version": "0.3.1",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "test": "jest",
    "lint": "expo lint",
    "verify": "tsc --noEmit && jest --ci --silent",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "ios": "expo run:ios",
    "build:apk": "npx eas build --platform android --profile preview --non-interactive",
    "build:dev": "npx eas build --platform android --profile development --non-interactive"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.0",
    "expo-blur": "~14.0.3",
    "expo-build-properties": "~0.13.3",
    "expo-clipboard": "~7.0.1",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.0",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-secure-store": "~14.0.0",
    "expo-sharing": "~13.0.1",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.0",
    "expo-updates": "~0.27.5",
    "lucide-react-native": "^1.47.0",
    "mirai-haptics": "file:./modules/mirai-haptics",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "^3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/react": "~18.3.12",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|expo-modules-core|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@react-navigation/.*|expo-sqlite|expo-secure-store)"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.scratch-",
      "/.git/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.scratch-",
      "<rootDir>/android/",
      "<rootDir>/dist/"
    ]
  }
}
